  "properties": {
    "protocol": {"const": "WEEK4_ADAPTIVE_RED_TEAM_A0"},
    "scientific_execution_enabled": {"const": false},
    "run_id": {"const": "week4_adaptive_redteam_v0"},
    "output_root": {"const": "results/week4_adaptive_redteam"},
    "defender": {"type": "object", "additionalProperties": false, "required": ["name", "window"], "properties": {"name": {"const": "B1b"}, "window": {"const": "S2_1500ms_250ms"}}},
    "generator": {"type": "object", "additionalProperties": false, "required": ["name", "repo_commit", "model_revision", "copy_week3_waveforms"], "properties": {"name": {"const": "F5-TTS v1 Base"}, "repo_commit": {"const": "82fc4fe622fe36047d1dff99b550e6018181ea11"}, "model_revision": {"const": "84e5a410d9cead4de2f847e7c9369a6440bdfaca"}, "copy_week3_waveforms": {"const": false}}},
    "population": {"type": "object", "additionalProperties": false, "required": ["target_cases", "dev_cases", "validation_cases", "held_out_cases", "selection_seed", "speaker_disjoint", "prior_week_speaker_exclusion"], "properties": {"target_cases": {"const": 48}, "dev_cases": {"const": 24}, "validation_cases": {"const": 12}, "held_out_cases": {"const": 12}, "selection_seed": {"const": 20260912}, "speaker_disjoint": {"const": true}, "prior_week_speaker_exclusion": {"const": true}}},
    "static_comparator": {"type": "object", "additionalProperties": false, "required": ["name", "insertion_position_rule", "crossfade_samples", "gain_db", "channel_rule", "gt_rule"], "properties": {"name": {"const": "A_STATIC"}, "insertion_position_rule": {"const": "middle_of_source_active_interval_round_down"}, "crossfade_samples": {"const": 400}, "gain_db": {"const": 0.0}, "channel_rule": {"const": "mono_16khz_no_channel_postprocess"}, "gt_rule": {"const": "sample_first_deterministic"}}},
    "attack_parameters": {"type": "object", "additionalProperties": false, "required": ["insertion_crossfade_samples", "synthetic_gain_db"], "properties": {"insertion_crossfade_samples": {"type": "object", "additionalProperties": false, "required": ["unit", "minimum", "maximum", "default", "resolution", "algorithm", "validity_rule"], "properties": {"unit": {"const": "samples_at_16khz"}, "minimum": {"const": 160}, "maximum": {"const": 400}, "default": {"const": 400}, "resolution": {"const": 80}, "algorithm": {"const": "linear_insertion_crossfade"}, "validity_rule": {"const": "integer_grid_and_sample_first_gt"}}}, "synthetic_gain_db": {"type": "object", "additionalProperties": false, "required": ["unit", "minimum", "maximum", "default", "resolution", "algorithm", "validity_rule"], "properties": {"unit": {"const": "dB"}, "minimum": {"const": -3.0}, "maximum": {"const": 3.0}, "default": {"const": 0.0}, "resolution": {"const": 0.5}, "algorithm": {"const": "multiply_synthetic_region_before_crossfade"}, "validity_rule": {"const": "finite_peak_not_above_0.999"}}}}},
    "insertion_position": {"type": "object", "additionalProperties": false, "required": ["adaptive_dimension", "rule"], "properties": {"adaptive_dimension": {"const": false}, "rule": {"const": "middle_of_source_active_interval_round_down"}}},
    "validity_contract": {"const": ["mono", "sample_rate_16000", "finite_samples", "no_nan_or_inf", "no_crop", "no_pad", "no_time_stretch", "text_content_identity_unchanged", "generator_output_identity_unchanged", "source_reference_identity_unchanged", "natural_duration_contract", "peak_not_above_0.999", "sample_first_deterministic_gt", "preregistered_transformations_only"]},
    "parameter_bounds": {"const": {"insertion_crossfade_samples": [160, 400], "synthetic_gain_db": [-3.0, 3.0]}},
    "parameter_defaults": {"const": {"insertion_crossfade_samples": 400, "synthetic_gain_db": 0.0}},
    "parameter_resolution": {"const": {"insertion_crossfade_samples": 80, "synthetic_gain_db": 0.5}},
