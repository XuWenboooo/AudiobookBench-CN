{
  "schema_version": "topconf.w7.gt_identity_binding.v1",
  "audit_date": "2026-09-15",
  "status": "FROZEN_SCHEMA_NO_CASES_MATERIALIZED",
  "purpose": "Bind audio, ground truth, model input and evaluation identities without exposing GT to inference",
  "v3_confirmatory_outcomes_accessed": false,
  "model_inference_may_read_ground_truth": false,
  "required_binding_fields": [
    "case_id",
    "dataset_id",
    "audio_identity",
    "audio_sha256",
    "ground_truth_identity",
    "ground_truth_sha256",
    "model_input_identity",
    "evaluation_identity"
  ],
  "record_schema": {
    "case_id": "opaque unique string",
    "dataset_id": "frozen dataset/version identifier",
    "audio_identity": "canonical relative path or content-addressed asset ID",
    "audio_sha256": "64-hex SHA256 of exact model input audio",
    "ground_truth_identity": "evaluation-only GT asset ID",
    "ground_truth_sha256": "64-hex SHA256 of exact GT asset",
    "model_input_identity": "hash of inference-safe manifest row; excludes GT and outcome fields",
    "evaluation_identity": "hash of evaluator-side joined row and frozen evaluator version"
  },
  "separation_rules": {
    "inference_view_fields": ["case_id", "dataset_id", "audio_identity", "audio_sha256", "duration_sec", "condition_id", "model_input_identity"],
    "evaluation_view_fields": ["case_id", "dataset_id", "ground_truth_identity", "ground_truth_sha256", "evaluation_identity"],
    "join_key": "case_id + dataset_id",
    "gt_revealed_before_terminal_raw_output": false,
    "unnecessary_gt_access": "fail closed",
    "v3_or_confirmatory_case_ids": "not permitted"
  },
  "records": []
}
