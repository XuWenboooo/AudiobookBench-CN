{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiobookbench.local/topconf/case-identity-v1",
  "title": "TopConf W7 canonical case identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "case_identity_hash", "distribution_id", "distribution_version", "split_id", "source_audio_id", "source_audio_hash", "manipulation_id", "manipulation_family", "manipulation_mechanism", "condition_id", "condition_type", "transform_id", "transform_version", "audio_artifact_id", "audio_artifact_hash", "gt_id", "gt_version", "whether_definition_id", "localizer_id", "model_checkpoint_id", "adapter_version"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^w7case_[0-9a-f]{32}$"},
    "case_identity_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "distribution_id": {"type": "string", "minLength": 1},
    "distribution_version": {"type": "string", "minLength": 1},
    "split_id": {"type": "string", "minLength": 1},
    "source_audio_id": {"type": "string", "minLength": 1},
    "source_audio_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_speaker_id": {"type": ["string", "null"]},
    "source_utterance_id": {"type": ["string", "null"]},
    "manipulation_id": {"type": "string", "minLength": 1},
    "manipulation_family": {"type": "string", "minLength": 1},
    "manipulation_mechanism": {"type": "string", "minLength": 1},
    "condition_id": {"type": "string", "minLength": 1},
    "condition_type": {"type": "string", "enum": ["clean", "mechanism_shift", "codec", "resampling"]},
    "transform_id": {"type": "string", "minLength": 1},
    "transform_version": {"type": "string", "minLength": 1},
    "audio_artifact_id": {"type": "string", "minLength": 1},
    "audio_artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gt_id": {"type": "string", "minLength": 1},
    "gt_version": {"type": "string", "minLength": 1},
    "gt_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "whether_definition_id": {"type": "string", "minLength": 1},
    "localizer_id": {"type": "string", "minLength": 1},
    "model_checkpoint_id": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1}
  }
}
